# =====================================================================
# O.S.M.U Keyword Researcher — 환경변수 예시
# =====================================================================
# 이 파일을 `.env`로 복사한 뒤 값을 채우세요.
# 자격증명이 비어 있으면 자동으로 로컬 CSV 폴백으로 동작합니다.

# ── 스토리지 백엔드 선택 ────────────────────────────────────────────────
# auto    : 자격증명/시트 있으면 mirror, 없으면 local (권장 기본)
# mirror  : Local CSV + Google Sheets 양방향 동기화 (가장 권장 — 빠르고 동기화)
# sheets  : Google Sheets 단독 (실시간 — 매 호출이 Sheets API)
# local   : Local CSV 단독 (오프라인, 가장 빠름)
OSMU_STORAGE_BACKEND=auto

# ── Google Sheets 연동 ────────────────────────────────────────────────
# Google Cloud Console에서 만든 서비스 계정 JSON 키 파일 경로
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service_account.json

# 시트 ID (URL의 /d/ 뒤 문자열) 또는 시트 제목
OSMU_SHEET_ID=
OSMU_SHEET_TITLE=OSMU_content_db

# 시트 내부 워크시트 이름 (없으면 자동 생성)
OSMU_WS_KEYWORD_POOL=keyword_pool
OSMU_WS_CONTENT_DB=content_db

# ── 평가 모듈(Evaluator) ──────────────────────────────────────────────
# heuristic : 내장 휴리스틱 (기본)
# naver_ads : Naver 검색광고 API (NAVER_* 변수 필요)
OSMU_EVALUATOR=heuristic

NAVER_AD_API_KEY=
NAVER_AD_SECRET=
NAVER_AD_CUSTOMER_ID=

# ── 키워드 풀 정책 ────────────────────────────────────────────────────
# 최대 보관 개수
OSMU_POOL_MAX_SIZE=50
# 키워드 유효기간(일). 시연용으로는 0.1(약 2.4시간)도 가능
OSMU_REVIVAL_DAYS=14
# 동일 seed 기반 콘텐츠 최소 재사용 간격(일)
OSMU_SEED_COOLDOWN_DAYS=7
# 황금 점수 임계치 — 이 점수 이상이면 풀에 저장
OSMU_GOLDEN_THRESHOLD=70
# 보통 점수 범위 — 이 사이면 키워드 연금술(변형)에 사용
OSMU_MEDIUM_LOWER=40
OSMU_MEDIUM_UPPER=70
